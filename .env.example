# Public Supabase project settings (safe to expose to the browser — protected by RLS).
# NEVER put the service-role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical public URL of the site (used for canonical tags, Open Graph and sitemap)
VITE_SITE_URL=https://www.bustlab.com

# Fallback store URLs used until they are set in Admin > Website Settings
VITE_SHOPIFY_STORE_URL=
VITE_ETSY_STORE_URL=
